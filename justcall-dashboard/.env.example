# Klucze z JustCall: Settings > Developers / API Credentials
JUSTCALL_API_KEY=
JUSTCALL_API_SECRET=

# Strefa czasowa, w której panel liczy dni i godziny
DASHBOARD_TZ=Europe/Warsaw

# Opcjonalnie: hasło do panelu (logowanie Basic Auth), zalecane gdy panel jest dostępny w sieci
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Adres i port serwera (0.0.0.0 udostępnia panel w sieci lokalnej)
HOST=127.0.0.1
PORT=8050

# Pipedrive: token z Ustawienia > Preferencje osobiste > API
PIPEDRIVE_API_TOKEN=
# Filtry leadów (ID:nazwa regionu). ID widać w adresie filtra w Pipedrive.
PIPEDRIVE_LEAD_FILTERS=59:PL,157:EU,60:US
